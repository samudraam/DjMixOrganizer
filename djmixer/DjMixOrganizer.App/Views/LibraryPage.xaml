<?xml version="1.0" encoding="utf-8" ?>
<!--
File location: DjMixOrganizer.App/Views/LibraryPage.xaml

TEACHING NOTES
==============
CollectionView.SelectionMode="Single" + SelectedItem="{Binding SelectedTrack}"
is a two-way binding on the SELECTION itself (which item is chosen), even
though the right-hand detail panel below only reads FROM SelectedTrack
(one-way). Those are two different bindings on the same property, going
in different directions for different reasons — worth being able to name
in an interview.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DjMixOrganizer.App.ViewModels"
             xmlns:models="clr-namespace:DjMixOrganizer.Core.Models;assembly=DjMixOrganizer.Core"
             xmlns:controls="clr-namespace:DjMixOrganizer.App.Controls"
             x:Class="DjMixOrganizer.App.Views.LibraryPage"
             x:DataType="viewmodels:LibraryViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource SurfaceBody}">

        <Grid Grid.Row="0" Style="{StaticResource ScreenHeader}">
            <Label Text="Library" Style="{StaticResource ScreenTitle}" />
        </Grid>

        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource SurfaceBody}"
              ColumnDefinitions="260,*"
              Padding="16"
              ColumnSpacing="16">

            <!-- Left: "Your Tracks" sidebar — shared with MixDetailPage, see
                 Controls/TrackListPanel.xaml. -->
            <controls:TrackListPanel Grid.Column="0"
                                      TracksSource="{Binding Tracks}"
                                      SelectedTrack="{Binding SelectedTrack}" />

            <!-- Right: selected-track detail panel -->
            <Border Grid.Column="1" Style="{StaticResource PanelCard}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="20" x:DataType="viewmodels:LibraryViewModel">

                    <Border Grid.Row="0"
                            HeightRequest="220"
                            WidthRequest="220"
                            HorizontalOptions="Center"
                            Stroke="{StaticResource NodeMagenta}"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource SurfacePanelDark}">
                        <Label Text="&#9835;"
                               FontSize="60"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Gray300}" />
                    </Border>

                    <VerticalStackLayout Grid.Row="1" Spacing="6" BindingContext="{Binding SelectedTrack}" x:DataType="models:Track">
                        <Label Text="{Binding DisplayName}" Style="{StaticResource SectionTitle}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="{Binding Bpm, StringFormat='BPM : {0}'}" FontSize="16" />
                        <Label Text="{Binding CamelotKey, StringFormat='Key : {0}'}" FontSize="13" />
                        <Label Text="Song info including key"
                               FontSize="12"
                               TextColor="{StaticResource Gray300}" />
                    </VerticalStackLayout>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
