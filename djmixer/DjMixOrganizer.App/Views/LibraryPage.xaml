<?xml version="1.0" encoding="utf-8" ?>
<!--
File location: DjMixOrganizer.App/Views/LibraryPage.xaml

Phase 1 scaffold: header + correct background + Shell TabBar navigation.
Track list / detail panel content lands in Phase 2 — see LibraryViewModel.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DjMixOrganizer.App.ViewModels"
             x:Class="DjMixOrganizer.App.Views.LibraryPage"
             x:DataType="viewmodels:LibraryViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Style="{StaticResource ScreenHeader}">
            <Label Text="Library" Style="{StaticResource ScreenTitle}" />
        </Grid>

        <Grid Grid.Row="1" BackgroundColor="{StaticResource SurfaceBody}">
            <Label Text="Track list and detail panel land here in Phase 2."
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
