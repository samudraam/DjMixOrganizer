<?xml version="1.0" encoding="utf-8" ?>
<!--
File location: DjMixOrganizer.App/Views/MixDetailPage.xaml

TEACHING NOTES
==============
This is the node-based mix editor brainstormed in README.md, turned into
something you can actually drag. Three things worth being able to explain:

1. AbsoluteLayout + BindableLayout.ItemsSource is what lets each TrackNode
   render at an explicit X/Y (via CanvasPositionToBoundsConverter) instead
   of auto-flowing like a Grid/StackLayout would — the one MAUI layout that
   supports "put this exactly here."

2. Dragging uses View.TranslationX/TranslationY (a visual transform, set in
   MixDetailPage.xaml.cs), not a bound Position property. TrackNode.Position
   only gets written once, when the drag ends. Presentation state vs.
   domain state — same reasoning the README gives for MixCanvas vs. Mix.

3. The GraphicsView behind the nodes redraws its connector lines on every
   drag tick, reading each node's live TranslationX/Y off the actual Border
   view (see the Draw method in the code-behind) — it doesn't wait for the
   drag to finish.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DjMixOrganizer.App.ViewModels"
             xmlns:models="clr-namespace:DjMixOrganizer.Core.Models;assembly=DjMixOrganizer.Core"
             xmlns:controls="clr-namespace:DjMixOrganizer.App.Controls"
             xmlns:converters="clr-namespace:DjMixOrganizer.App.Converters"
             x:Class="DjMixOrganizer.App.Views.MixDetailPage"
             x:DataType="viewmodels:MixDetailViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <converters:CanvasPositionToBoundsConverter x:Key="PositionToBoundsConverter" />
        <converters:HexToColorConverter x:Key="HexToColorConverter" />
        <converters:HexToDarkerColorConverter x:Key="HexToDarkerColorConverter" />
        <converters:TrackNodeToWaveformBarsConverter x:Key="WaveformConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource SurfaceBody}">

        <Grid Grid.Row="0" Style="{StaticResource ScreenHeader}" ColumnDefinitions="60,*,90">
            <Button Grid.Column="0"
                    Text="&#8592;"
                    FontSize="22"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gray600}"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    Margin="12,0,0,0" />

            <!-- Was a static "Mix" Label — there was no title input
                 anywhere in the app, and Mix.Title is required, so Save
                 needs a source for it. ScreenTitle is TargetType="Label",
                 so its font tokens are set manually here instead. -->
            <Entry Grid.Column="1"
                   Text="{Binding MixTitle}"
                   Placeholder="Mix title"
                   FontFamily="JuraDemiBold"
                   FontSize="22"
                   TextColor="{StaticResource Gray600}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Save"
                    Command="{Binding SaveMixCommand}"
                    HorizontalOptions="End"
                    Margin="0,0,12,0" />
        </Grid>

        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource SurfaceBody}"
              ColumnDefinitions="260,*"
              Padding="16"
              ColumnSpacing="16">

            <!-- Shared with LibraryPage — see Controls/TrackListPanel.xaml.
                 Tapping a row here sets SelectedTrackToAdd, which
                 MixDetailViewModel reacts to by adding a node to the
                 canvas (see its OnSelectedTrackToAddChanged). -->
            <controls:TrackListPanel Grid.Column="0"
                                      TracksSource="{Binding AvailableTracks}"
                                      SelectedTrack="{Binding SelectedTrackToAdd}" />

            <Grid Grid.Column="1">

                <!-- Behind the nodes: draws connector lines between
                     consecutive nodes. InputTransparent so drag/tap
                     gestures pass through to the node cards on top. -->
                <GraphicsView x:Name="ConnectionsCanvas"
                              BackgroundColor="Transparent"
                              InputTransparent="True" />

                <AbsoluteLayout x:Name="NodesLayout"
                                BindableLayout.ItemsSource="{Binding Nodes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackNode">
                            <Border AbsoluteLayout.LayoutBounds="{Binding Position, Converter={StaticResource PositionToBoundsConverter}}"
                                    Stroke="{Binding AccentColorHex, Converter={StaticResource HexToColorConverter}}"
                                    StrokeThickness="3"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10"
                                    Loaded="OnNodeCardLoaded">

                                <!-- Vertical gradient: the node's own accent
                                     color at the top, fading to black at the
                                     bottom (see the linear-gradient docs). -->
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{Binding AccentColorHex, Converter={StaticResource HexToColorConverter}}" Offset="0.0" />
                                        <GradientStop Color="Black" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>

                                <Border.GestureRecognizers>
                                    <PanGestureRecognizer PanUpdated="OnNodePanUpdated" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">

                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Track.Title}"
                                               Style="{StaticResource ItemTitle}"
                                               TextColor="White"
                                               FontSize="14"
                                               LineBreakMode="TailTruncation" />

                                        <!-- Removes this node from the canvas. Bound to the
                                             page's ViewModel (not this DataTemplate's own
                                             TrackNode context), same cross-scope pattern the
                                             waveform bars below use to reach back out to
                                             AccentColorHex. -->
                                        <Button Grid.Column="1"
                                                Text="&#215;"
                                                FontSize="14"
                                                TextColor="White"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                CornerRadius="10"
                                                HeightRequest="20"
                                                WidthRequest="20"
                                                MinimumHeightRequest="20"
                                                MinimumWidthRequest="20"
                                                VerticalOptions="Start"
                                                HorizontalOptions="End"
                                                Command="{Binding BindingContext.RemoveNodeCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <!-- Static waveform bars — placeholder,
                                         not real audio analysis (see
                                         TrackNodeToWaveformBarsConverter). -->
                                    <HorizontalStackLayout Grid.Row="1"
                                                            Spacing="2"
                                                            HeightRequest="28"
                                                            VerticalOptions="End"
                                                            BindableLayout.ItemsSource="{Binding ., Converter={StaticResource WaveformConverter}}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:Double">
                                                <BoxView WidthRequest="4"
                                                         HeightRequest="{Binding .}"
                                                         Color="{Binding BindingContext.AccentColorHex, Source={RelativeSource AncestorType={x:Type Border}}, Converter={StaticResource HexToDarkerColorConverter}}"
                                                         VerticalOptions="End" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>

                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="BPM :" TextColor="{StaticResource Gray200}" FontSize="12" VerticalOptions="Center" />
                                        <Entry Grid.Column="1" Text="{Binding Bpm}" Keyboard="Numeric" FontSize="12" TextColor="White" />
                                    </Grid>

                                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="Key :" TextColor="{StaticResource Gray200}" FontSize="12" VerticalOptions="Center" />
                                        <Picker Grid.Column="1"
                                                ItemsSource="{x:Static viewmodels:MixDetailViewModel.CamelotKeys}"
                                                SelectedItem="{Binding Key}"
                                                FontSize="12"
                                                TextColor="White" />
                                    </Grid>

                                    <Grid Grid.Row="4" ColumnDefinitions="*,*,*">
                                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                                            <Label Text="Vocals" FontSize="9" TextColor="{StaticResource Gray200}" HorizontalOptions="Center" />
                                            <Switch IsToggled="{Binding HasVocals}" Scale="0.65" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label Text="Perc." FontSize="9" TextColor="{StaticResource Gray200}" HorizontalOptions="Center" />
                                            <Switch IsToggled="{Binding HasPercussion}" Scale="0.65" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="0">
                                            <Label Text="Music" FontSize="9" TextColor="{StaticResource Gray200}" HorizontalOptions="Center" />
                                            <Switch IsToggled="{Binding HasMusic}" Scale="0.65" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="5" Spacing="0">
                                        <Label Text="Track Sections:" FontSize="9" TextColor="{StaticResource Gray200}" />
                                        <Entry Text="{Binding TrackSectionsText}" FontSize="9" TextColor="White" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </AbsoluteLayout>

                <Button Text="Edit Color"
                        Command="{Binding EditColorCommand}"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,10,10" />

            </Grid>

        </Grid>

    </Grid>

</ContentPage>
