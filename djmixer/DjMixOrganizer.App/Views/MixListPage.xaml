<?xml version="1.0" encoding="utf-8" ?>
<!--
File location: DjMixOrganizer.App/Views/MixListPage.xaml

TEACHING NOTES
==============
This is the "View" in MVVM. Two things make that true:

1. x:DataType="viewmodels:MixListViewModel" tells the XAML compiler which
   type this page binds against, so every {Binding ...} below is checked
   at compile time instead of failing silently at runtime with a typo.

2. Nothing in this file reaches into DjMixOrganizer.Core or touches a Mix
   object directly beyond what's needed to display it. Coloring/joining
   logic for the "Track x Track" title lives in a converter
   (Converters/MixTrackFormattingConverters.cs), not here and not on Mix
   itself — the View stays declarative, the Mix model stays UI-agnostic.

CollectionView + ItemsSource="{Binding Mixes}" is the MAUI equivalent of
mapping over a list in React (`mixes.map(mix => <Row .../>)`) or a
ListView.builder in Flutter — it re-renders items automatically because
Mixes is an ObservableCollection (see the ViewModel's teaching notes).

CollectionView.Footer is what renders the trailing "+" create card
regardless of how many mixes exist — cleaner than trying to special-case
"the last item" inside the ItemTemplate.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DjMixOrganizer.App.ViewModels"
             xmlns:models="clr-namespace:DjMixOrganizer.Core.Models;assembly=DjMixOrganizer.Core"
             xmlns:converters="clr-namespace:DjMixOrganizer.App.Converters"
             x:Class="DjMixOrganizer.App.Views.MixListPage"
             x:Name="Root"
             x:DataType="viewmodels:MixListViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:MixTitleToFormattedStringConverter x:Key="MixTitleConverter" />
        <converters:MixArtistsToStringConverter x:Key="MixArtistsConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: header + loading spinner -->
        <Grid Grid.Row="0" Style="{StaticResource ScreenHeader}">
            <Label Text="Mixes" Style="{StaticResource ScreenTitle}" />
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                IsVisible="{Binding IsLoading}"
                                HorizontalOptions="End"
                                Margin="0,0,20,0" />
        </Grid>

        <!-- Row 1: the list itself, inside one big panel card matching the
             mockup's outer gray-purple container. -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelCard}"
                Margin="20"
                BackgroundColor="{StaticResource SurfacePanel}">

            <CollectionView ItemsSource="{Binding Mixes}" SelectionMode="None">

                <!-- Shown instead of the CollectionView's items when Mixes is
                     empty and we're not currently loading. -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="No mixes yet." FontSize="16" HorizontalOptions="Center" />
                        <Label Text="Tap the + card below to start one."
                               FontSize="13"
                               TextColor="{StaticResource Gray300}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Mix">
                        <Border BackgroundColor="White"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,12"
                                Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenMixCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label FormattedText="{Binding ., Converter={StaticResource MixTitleConverter}}"
                                       FontSize="17"
                                       TextColor="Black" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding ., Converter={StaticResource MixArtistsConverter}}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding RecordedDate, StringFormat='{0:MMM d, yyyy}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Border BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            HeightRequest="72">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateMixCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="+"
                               FontSize="28"
                               TextColor="Black"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </CollectionView.Footer>

            </CollectionView>
        </Border>

    </Grid>

</ContentPage>
