<?xml version="1.0" encoding="utf-8" ?>
<!--
File location: DjMixOrganizer.App/Views/MixListPage.xaml

TEACHING NOTES
==============
This is the "View" in MVVM. Two things make that true:

1. x:DataType="viewmodels:MixListViewModel" tells the XAML compiler which
   type this page binds against, so every {Binding ...} below is checked
   at compile time instead of failing silently at runtime with a typo.

2. Nothing in this file reaches into DjMixOrganizer.Core or touches a Mix
   object directly. It only knows about properties on the ViewModel
   (Mixes, IsLoading, LoadMixesCommand). The View is "dumb" on purpose —
   swap MixListViewModel for a different one with the same shape and this
   XAML doesn't need to change.

CollectionView + ItemsSource="{Binding Mixes}" is the MAUI equivalent of
mapping over a list in React (`mixes.map(mix => <Row .../>)`) or a
ListView.builder in Flutter — it re-renders items automatically because
Mixes is an ObservableCollection (see the ViewModel's teaching notes).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DjMixOrganizer.App.ViewModels"
             xmlns:models="clr-namespace:DjMixOrganizer.Core.Models;assembly=DjMixOrganizer.Core"
             x:Class="DjMixOrganizer.App.Views.MixListPage"
             x:DataType="viewmodels:MixListViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: header + loading spinner -->
        <Grid Grid.Row="0" Style="{StaticResource ScreenHeader}">
            <Label Text="Mixes" Style="{StaticResource ScreenTitle}" />
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                IsVisible="{Binding IsLoading}"
                                HorizontalOptions="End"
                                Margin="0,0,20,0" />
        </Grid>

        <!-- Row 1: the list itself. Padding lives on the wrapping Grid, not
             the CollectionView — CollectionView's Padding binding doesn't
             play well with the XAML source generator in this SDK version. -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource SurfaceBody}" Padding="20">
        <CollectionView ItemsSource="{Binding Mixes}"
                         SelectionMode="None">

            <!-- Shown instead of the CollectionView's items when Mixes is empty
                 and we're not currently loading. -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="No mixes yet." FontSize="16" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Tap &quot;Load Mixes&quot; to scan your library."
                           FontSize="13"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Mix">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding RecordedDate}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray200}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding TotalDuration, StringFormat='{0:hh\\:mm\\:ss}'}"
                                   VerticalOptions="Center"
                                   FontSize="14" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>

        <!-- Load button placed inside the body for now (Phase 3 replaces
             this row with a trailing "+" card in the list itself, matching
             the mockup). Kept here so the screen stays functional
             mid-refactor. -->
        <Button Grid.Row="1"
                Text="Load Mixes"
                Command="{Binding LoadMixesCommand}"
                VerticalOptions="End"
                Margin="20" />

    </Grid>

</ContentPage>
